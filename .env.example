# LLM keys — needed only by the HOT (author) and WARM (heal) lanes.
# The COLD replay lane has no LLM in its dependency graph and needs neither.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provider selection for the LLM seam: anthropic | openai (default: anthropic, falls back to openai)
# ANNEAL_LLM_PROVIDER=anthropic

# Postgres. Matches docker-compose.yml (host port 55432).
# ANNEAL_DB_URL=postgresql+psycopg://anneal:anneal@localhost:55432/anneal

# Where run artifacts (trace, video, screenshots, network logs) are written.
# ANNEAL_ARTIFACTS=./.anneal/artifacts

# Fernet key for the credential vault. With NO key set, Anneal REFUSES to store or read
# secret material rather than silently falling back to plaintext.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ANNEAL_VAULT_KEY=

# Dev only: allow the Vite console origin to call the API cross-origin.
# ANNEAL_CORS_ORIGINS=http://localhost:5173

# Prod: serve the built console same-origin from FastAPI (one deployable).
# ANNEAL_FRONTEND_DIST=frontend/dist
